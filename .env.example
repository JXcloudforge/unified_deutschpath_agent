# Local model provider. Empty key selects FakeLLM (offline), not DeepSeek.
# Set keys in the localhost Streamlit API Settings panel; restart FastAPI after saving.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional live search. Configuration alone does not verify Tavily connectivity.
TAVILY_API_KEY=

# Router: rules (offline) or hybrid (requires DeepSeek).
STAGE3_ROUTER=rules

# Embeddings: deterministic (offline) or e5 (model load/download may be needed).
STAGE2_EMBEDDING_PROVIDER=deterministic

# All chat, Chroma, upload, and MCP Host runtime data stays under this root.
STAGE2_DATA_PATH=data

# Optional MCP business database override; defaults to the data root.
# MCP_DATABASE_PATH=

# Streamlit API base URL. Override via this variable when needed.
DEUTSCHPATH_API_BASE_URL=http://127.0.0.1:8765

# The trusted Host stages OCR images under STAGE2_DATA_PATH/mcp_ocr_inputs.
# For standalone OCR MCP only, configure a dedicated absolute directory:
# OCR_INPUT_DIR=D:\Deutschpath\authorized-ocr-input
