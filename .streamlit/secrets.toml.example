# Copy to secrets.toml and replace every placeholder. Never commit secrets.toml.
# The provider section name below is a sample; set DEUTSCHPATH_OIDC_PROVIDER to match it.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
expose_tokens = "access"

[auth.auth0]
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://YOUR_TENANT.auth0.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email", audience = "https://YOUR_API_AUDIENCE" }
